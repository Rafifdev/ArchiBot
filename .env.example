# Discord Bot Token (Required)
DISCORD_TOKEN=paste_your_discord_bot_token_here

# Discord OAuth2 Dashboard Configuration (Optional: Can also be setup via Dashboard UI)
# DISCORD_CLIENT_ID will be auto-detected from bot client if not specified
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/callback

# Web Dashboard Server Port & Security
PORT=3001
JWT_SECRET=archibot_super_secret_dashboard_jwt_key_2026
FRONTEND_URL=http://localhost:5173

