{
  "name": "discord-server-generator-bot",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dashboard": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env server/dev.js",
